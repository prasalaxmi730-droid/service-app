{
  "expo": {
    "name": "prasa",
    "slug": "prasa",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/prasa_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/prasa_splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fieldservice.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/prasa_adaptive_icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "8b7ccb19-a500-4425-a65b-618f9e69bf71"
      }
    }
  }
}
